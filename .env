# Application environment. Options: development | production
# When unset, falls back to NODE_ENV, then 'development'.
APP_ENV=development

# Enable or disable backend logging entirely. Options: true | false.
# When unset, defaults to true (false when NODE_ENV === 'test').
LOG_ENABLED=true

# Minimum log level. Options: debug | info | warn | error.
# When unset, defaults to 'debug' in development, 'info' in production.
LOG_LEVEL=debug

# Canonical site URL — used for SEO metadata, robots.txt, sitemap.xml,
# OpenGraph, Twitter cards, llms.txt. Override per deploy (prod should be
# the real https://... host).
SITE_URL=http://localhost:3000/

# Database driver selection.
# auto (default): use Neon if DATABASE_URL is set, else PGlite-Node (dev only).
# neon: force Neon (requires DATABASE_URL).
# pglite: force PGlite-Node (local file-backed Postgres; dev-only).
DATABASE_MODE=auto

# Where PGlite-Node persists data when DATABASE_MODE=pglite. Relative to cwd.
PGLITE_DATA_DIR=./.data/pglite

# DATABASE_URL belongs in .env.local (gitignored) — it's a secret and
# differs per environment. Vercel auto-injects this when you add Neon
# via the Storage tab. See docs/database.md.

# OPENROUTER_API_KEY belongs in .env.local (gitignored). When unset, AI
# routes throw BackendError('OPENROUTER_API_KEY not set') on call — the
# app still boots so non-AI routes keep working. See docs/ai.md.

# Secrets live in .env.local (gitignored), never here.
# Examples:
# TWENTYFIRST_API_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# OPENROUTER_API_KEY=sk-or-v1-...
#
# Clerk: if unset, keyless mode auto-generates temporary keys in dev.
# Production must set real keys (see docs/auth.md).

# ── Race authority split ────────────────────────────────────────────
# The race-room store is in-memory. To keep cross-instance matchmaking
# from creating duplicate rooms, exactly one deployment runs as the
# authority and every other instance proxies to it.
#
# Local dev: defaults below = single-process behaviour, no proxy.
# Production Vercel: RACE_AUTHORITY=false + RACE_SERVICE_URL set.
# Production Railway: RACE_AUTHORITY=true + RACE_PROXY_SECRET set.
#
# `true` | `false`. Default `true` so local dev + tests work without
# any extra env wiring.
RACE_AUTHORITY=true
# Origin of the authority instance — only used when RACE_AUTHORITY=false.
# Example: RACE_SERVICE_URL=https://race.flinttype.com
# RACE_SERVICE_URL=
# Shared secret. When set on the authority, requests missing or
# mismatching `x-flinttype-race-secret` are 401-rejected. Set the
# same value on Vercel so its proxy carries it. Belongs in
# .env.local — gitignored. See docs/multiplayer.md.
# RACE_PROXY_SECRET=
# Browser-facing base URL for SSE. When set, the EventSource opens
# `${NEXT_PUBLIC_RACE_SERVICE_URL}/api/race/stream/<id>` instead of a
# same-origin URL. Must match RACE_SERVICE_URL in production.
# NEXT_PUBLIC_RACE_SERVICE_URL=

# Clerk — route URLs for dedicated sign-in / sign-up pages. These must
# match the actual routes in src/app/sign-in and src/app/sign-up so that
# <UserButton />, <SignedOut>, and internal Clerk redirects send users
# to our pages instead of Clerk's hosted accounts portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
