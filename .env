# Application environment. Options: development | production
# When unset, falls back to NODE_ENV, then 'development'.
APP_ENV=development

# Enable or disable backend logging entirely. Options: true | false.
# When unset, defaults to true (false when NODE_ENV === 'test').
LOG_ENABLED=true

# Minimum log level. Options: debug | info | warn | error.
# When unset, defaults to 'debug' in development, 'info' in production.
LOG_LEVEL=debug

# Canonical site URL — used for SEO metadata, robots.txt, sitemap.xml,
# OpenGraph, Twitter cards, llms.txt. Override per deploy (prod should be
# the real https://... host).
SITE_URL=http://localhost:3000

# Database driver selection.
# auto (default): use Neon if DATABASE_URL is set, else PGlite-Node (dev only).
# neon: force Neon (requires DATABASE_URL).
# pglite: force PGlite-Node (local file-backed Postgres; dev-only).
DATABASE_MODE=auto

# Where PGlite-Node persists data when DATABASE_MODE=pglite. Relative to cwd.
PGLITE_DATA_DIR=./.data/pglite

# DATABASE_URL belongs in .env.local (gitignored) — it's a secret and
# differs per environment. Vercel auto-injects this when you add Neon
# via the Storage tab. See docs/database.md.

# Secrets live in .env.local (gitignored), never here.
# Examples:
# TWENTYFIRST_API_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
#
# Clerk: if unset, keyless mode auto-generates temporary keys in dev.
# Production must set real keys (see docs/auth.md)....
