# Application environment. Options: development | production
# When unset, falls back to NODE_ENV, then 'development'.
APP_ENV=development

# Enable or disable backend logging entirely. Options: true | false.
# When unset, defaults to true (false when NODE_ENV === 'test').
LOG_ENABLED=true

# Minimum log level. Options: debug | info | warn | error.
# When unset, defaults to 'debug' in development, 'info' in production.
LOG_LEVEL=debug

# Canonical site URL — used for SEO metadata, robots.txt, sitemap.xml,
# OpenGraph, Twitter cards, llms.txt. Override per deploy (prod should be
# the real https://... host).
SITE_URL=http://localhost:3000

# Secrets live in .env.local (gitignored), never here.
# Example:
# TWENTYFIRST_API_KEY=...
